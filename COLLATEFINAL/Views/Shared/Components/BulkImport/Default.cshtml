<!-- Bulk Import Modal -->
<div class="modal fade" id="bulkImportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkImportModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="bulkImportForm" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3" id="bulkImportModalBody">
                        <label class="mb-1 small text-muted" for="file">
                            Import Database (<code>.csv</code> & <code>.xlsx</code> only)
                        </label>
                        <input type="file" id="file" name="file" class="form-control"
                               accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-danger-soft text-danger" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary-soft text-primary">
                        Import
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modalElement = document.getElementById("bulkImportModal");
        if (!modalElement) return;

        const modal = new bootstrap.Modal(modalElement);
        const form = document.getElementById("bulkImportForm");
        const modalTitle = document.getElementById("bulkImportModalTitle");
        const modalBody = document.getElementById("bulkImportModalBody");

        // Example: dynamically open the modal
        document.body.addEventListener("click", (e) => {
            const button = e.target.closest(".open-bulk-import-modal");
            if (!button) return;

            const { title, action } = button.dataset;

            modalTitle.textContent = title || "Bulk Import";
            form.action = action || form.getAttribute("asp-action");

            modal.show();
        });
    });
</script>
