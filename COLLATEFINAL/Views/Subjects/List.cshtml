@model IEnumerable<SubjectModel>

@{
    ViewData["Title"] = "List";
    ViewData["ActivePage"] = ManageSidebar.CMSPrototype;

}
<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<style>
    div.scrollmenu {
        background-color: white;
        overflow: auto;
        white-space: nowrap;
    }

        div.scrollmenu a {
            display: inline-block;
            color: white;
            text-align: center;
            padding: 14px;
            text-decoration: none;
        }

            div.scrollmenu a:hover {
                background-color: #777;
            }
</style>
<partial name="_NewNavbar" />
<div id="layoutSidenav">
    <partial name="_NewSidenav" />
    <div id="layoutSidenav_content">
        <main>
            <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
                <div class="container-fluid px-4">
                    <div class="page-header-content">
                        <div class="row align-items-center justify-content-between pt-3">
                            <div class="col-auto mb-3">
                                <h1 class="page-header-title">
                                    <div class="page-header-icon"><i data-feather="bookmark"></i></div>
                                    Subjects
                                </h1>
                            </div>
                            <div class="col-12 col-xl-auto mb-3">
                                <button class="btn btn-sm btn-light text-primary open-bulk-import-modal" data-title="Import Subjects" data-action="/Subjects/BulkImportSamples">
                                    <i class="me-1" data-feather="upload"></i>
                                    Import
                                </button>
                                <a class="btn btn-sm btn-light text-primary" asp-action="ListLectures" asp-controller="Prototype">
                                    <i class="me-1" data-feather="book"></i>
                                    Lectures
                                </a>
                                <a class="btn btn-sm btn-light text-primary" asp-action="ListVideos" asp-controller="Prototype">
                                    <i class="me-1" data-feather="video"></i>
                                    Videos
                                </a>
                                <a class="btn btn-sm btn-light text-primary" asp-action="Create" asp-controller="Subjects">
                                    <i class="me-1" data-feather="plus"></i>
                                    Create New
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!-- Main page content-->
            <div class="container-xl px-4 mt-4">
                <partial name="_Notification" />

                <div class="card card-scrollable">
                    <div class="card-header">
                        <input type="checkbox" id="selectAll" /> Select All
                        <button id="btnDeleteSelected"
                                class="btn btn-datatable btn-icon btn-transparent-dark float-end"
                                data-delete-url="/Subjects/DeleteMultiple"
                                disabled>
                            <i data-feather="trash-2"></i>
                        </button>
                    </div>
                    <div class="card-body" style="max-height:50rem">
                        <table id="datatablesSimple">
                            @if (Model.Count() == 0)
                            {
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {

                                        <tr>
                                            <td>
                                                <span class="badge bg-blue-soft text-blue">@item.Code</span>
                                            </td>
                                            <td>@item.Subject</td>
                                            <td>@item.PostedDate.ToString("dddd, dd MMMM yyyy")</td>
                                            <td>
                                                <a class="btn btn-datatable btn-icon btn-transparent-dark me-2" asp-action="Edit" asp-controller="Subjects" asp-route-id="@item.Id"><i data-feather="edit"></i></a>
                                                <button class="btn btn-datatable btn-icon btn-transparent-dark open-delete-modal me-2" data-id="@item.Id" data-name="@item.Code" data-title="Delete Subject" data-action="/Subjects/Delete">
                                                    <i data-feather="trash-2"></i>
                                                </button>
                                                <input id="@item.Code" type="checkbox"
                                                       class="btn row-checkbox"
                                                       value="@item.Id" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
            @await Component.InvokeAsync("DeleteModal")
            @await Component.InvokeAsync("BulkImport")
        </main>
        <partial name="_NewFooter" />
    </div>
</div>



@section Scripts {
    <script src="~/js/CustomScripts.js"></script>
}

