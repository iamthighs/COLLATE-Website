@model IEnumerable<LectureModel>

@{
    ViewData["Title"] = "List";
    ViewData["ActivePage"] = ManageSidebar.CMSPrototype;

}
<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<partial name="_NewNavbar" />
<div id="layoutSidenav">
    <partial name="_NewSidenav" />
    <div id="layoutSidenav_content">
        <main>
            <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
                <div class="container-fluid px-4">
                    <div class="page-header-content">
                        <div class="row align-items-center justify-content-between pt-3">
                            <div class="col-auto mb-3">
                                <h1 class="page-header-title">
                                    <div class="page-header-icon"><i data-feather="book"></i></div>
                                    Lectures
                                </h1>
                            </div>
                            <div class="col-12 col-xl-auto mb-3">
                                <button class="btn btn-sm btn-light text-primary open-bulk-import-modal" data-title="Import Subjects" data-action="/Prototype/BulkImportLectures">
                                    <i class="me-1" data-feather="upload"></i>
                                    Import
                                </button>
                                <a class="btn btn-sm btn-light text-primary" asp-action="List" asp-controller="Subjects">
                                    <i class="me-1" data-feather="bookmark"></i>
                                    Subjects
                                </a>
                                <a class="btn btn-sm btn-light text-primary" asp-action="ListVideos" asp-controller="Prototype">
                                    <i class="me-1" data-feather="video"></i>
                                    Videos
                                </a>
                                <a class="btn btn-sm btn-light text-primary" asp-action="CreateLecture" asp-controller="Prototype">
                                    <i class="me-1" data-feather="plus"></i>
                                    Create New
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!-- Main page content-->
            <div class="container-xl px-4">
                <partial name="_Notification" />
                <div class="card card-scrollable">
                    <div class="card-header">
                        <input type="checkbox" id="selectAll" /> Select All
                        <button id="btnDeleteSelected"
                                class="btn btn-datatable btn-icon btn-transparent-dark float-end"
                                data-delete-url="/Prototype/DeleteMultipleLectures"
                                disabled>
                            <i data-feather="trash-2"></i>
                        </button>
                    </div>
                    <div class="card-body" style="max-height:50rem">
                        <table id="datatablesSimple">
                            @if (Model.Count() == 0)
                            {
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Title</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Title</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {

                                        <tr>
                                            <td>
                                                <span class="badge bg-blue-soft text-blue">@item.Subject</span>
                                            </td>
                                            <td>@item.Title</td>
                                            <td>@item.PostedDate.ToString("dddd, dd MMMM yyyy")</td>
                                            <td>
                                                <a class="btn btn-datatable btn-icon btn-transparent-dark me-2" asp-action="EditLecture" asp-controller="Prototype" asp-route-id="@item.Id"><i data-feather="edit"></i></a>
                                                <button class="btn btn-datatable btn-icon btn-transparent-dark open-delete-modal me-2" data-id="@item.Id" data-name="@item.Title" data-title="Delete Lecture" data-action="/Prototype/DeleteConfirmedLecture">
                                                    <i data-feather="trash-2"></i>
                                                </button>
                                                <input id="@item.Title" type="checkbox"
                                                       class="btn row-checkbox"
                                                       value="@item.Id" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
            @await Component.InvokeAsync("DeleteModal")
            @await Component.InvokeAsync("BulkImport")
        </main>
        <partial name="_NewFooter" />
    </div>
</div>

@section Scripts {
    <script src="~/js/CustomScripts.js"></script>
}