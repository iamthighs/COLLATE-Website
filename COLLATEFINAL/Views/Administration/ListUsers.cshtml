@model List<COLLATE.Helpers.ViewModels.UserWithRolesViewModel>

@{
    ViewData["Title"] = "All Users";
    ViewData["ActivePage"] = ManageSidebar.ListUsers;
}



<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" />

<partial name="_NewNavbar" />
<div id="layoutSidenav">
    <partial name="_NewSidenav"/>
    <div id="layoutSidenav_content">
        <main>
            <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
                <div class="container-fluid px-4">
                    <div class="page-header-content">
                        <div class="row align-items-center justify-content-between pt-3">
                            <div class="col-auto mb-3">
                                <h1 class="page-header-title">
                                    <div class="page-header-icon"><i data-feather="user"></i></div>
                                    Users List
                                </h1>
                            </div>
                            <div class="col-12 col-xl-auto mb-3">
                                <a class="btn btn-sm btn-light text-primary" asp-action="ListRoles">
                                    <i class="me-1" data-feather="users"></i>
                                    Manage Roles
                                </a>
                                <a class="btn btn-sm btn-light text-primary" asp-area="Identity" asp-page="/Account/RegisterAdmin">
                                    <i class="me-1" data-feather="user-plus"></i>
                                    Add New User
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!-- Main page content-->
            <div class="container-fluid px-4">
                <div class="card card-scrollable">
                    <div class="card-header">
                        <input type="checkbox" id="selectAll" /> Select All
                        <button id="btnDeleteSelected"
                                class="btn btn-datatable btn-icon btn-transparent-dark float-end"
                                data-delete-url="/Administration/DeleteMultipleUsers"
                                disabled>
                            <i data-feather="trash-2"></i>
                        </button>
                    </div>
                    <div class="card-body" style="max-height:50rem">
                        <table id="datatablesSimple">
                            @if (Model.Count() == 0)
                            {
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Joined Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                            }
                            else
                            {
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Joined Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar me-2"><img class="avatar-img img-fluid" src="~/UserImages/@user.User.ImageUrl" /></div>
                                                    @user.User.FirstName @user.User.LastName
                                                </div>
                                            </td>
                                            <td>@user.User.Email</td>
                                            <td>
                                                @foreach (var role in user.Roles)
                                                {
                                                    if (role == "Administrator")
                                                    {
                                                        <span class="badge bg-purple-soft text-purple">@role</span>
                                                    }
                                                    else if (role == "sceneOfficer")
                                                    {
                                                        <span class="badge bg-green-soft text-green">SCENE Officer</span>
                                                    }
                                                    else if (role == "Faculty")
                                                    {
                                                        <span class="badge bg-yellow-soft text-yellow">@role</span>
                                                    }
                                                    else if (role == "Student")
                                                    {
                                                        <span class="badge bg-blue-soft text-blue">@role</span>
                                                    }
                                                    else{
                                                        <span class="badge bg-gray-300 text-dark">@role</span>
                                                    }

                                                }
                                            </td>
                                            <td>@user.User.JoinedDate.ToString("dddd, dd MMMM yyyy")</td>
                                            <td>
                                                <a class="btn btn-datatable btn-icon btn-transparent-dark me-2" asp-action="EditUser" asp-controller="Administration" asp-route-id="@user.User.Id"><i data-feather="edit"></i></a>
                                                <button class="btn btn-datatable btn-icon btn-transparent-dark open-delete-modal me-2" data-id="@user.User.Id" data-name="@user.User.UserName" data-title="Delete User" data-action="/Administration/DeleteUser">
                                                    <i data-feather="trash-2"></i>
                                                </button>
                                                <input id="@user.User.UserName" type="checkbox"
                                                       class="btn row-checkbox"
                                                       value="@user.User.Id" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                </div>
            </div>
            @await Component.InvokeAsync("DeleteModal")
        </main>
        <partial name="_NewFooter"/>
    </div>
</div>


@section Scripts {
    <script src="~/js/CustomScripts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest" crossorigin="anonymous"></script>
    <script src="~/js/datatables/datatables-simple-demo.js"></script>
}