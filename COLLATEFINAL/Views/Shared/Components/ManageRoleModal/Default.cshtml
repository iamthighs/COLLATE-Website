<div class="modal fade" id="manageRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="container-xl px-4 mt-4">
                    <div class="row">
                        <!-- LEFT: Role + Users Card -->
                        <div class="col-xl-4">
                            <div class="card card-header-actions mb-4 mb-xl-0">
                                <div class="card-header">
                                    <div>Members</div>
                                    <div class="dropdown no-caret">
                                        <button class="btn btn-transparent-dark btn-icon dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            <i class="text-gray-500" data-feather="more-vertical"></i>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end animated--fade-in-up">
                                            <h6 class="dropdown-header">Manage</h6>
                                            <a id="editUsersLink" class="dropdown-item">
                                                <span class="badge bg-blue-soft text-blue my-1">Users in Role</span>
                                            </a>
                                            <a id="editClaimsLink" class="dropdown-item">
                                                <span class="badge bg-blue-soft text-blue my-1">Role Claims</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-body" id="usersCardBody">
                                    <!-- Users will be injected here -->
                                    <span class="badge bg-red-soft text-red">None at the moment</span>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Role Details Card -->
                        <div class="col-xl-8">
                            <div class="card mb-4">
                                <div class="card-header">Role Details</div>
                                <div class="card-body">
                                    <div class="row gx-3 mb-3">
                                        <div class="col-md-6">
                                            <p class="text-dark line-height-normal mb-1">Unique ID:</p>
                                            <p><span id="roleId" class="badge bg-blue-soft text-blue"></span></p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="text-dark line-height-normal mb-1">Name:</p>
                                            <p><span id="roleNameD" class="badge bg-blue-soft text-blue"></span></p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
            document.addEventListener("DOMContentLoaded", () => {
        const modalTitle = document.getElementById("modalTitle");
        const modalElement = document.getElementById("manageRoleModal");
        const bootstrapModal = new bootstrap.Modal(modalElement);
        const roleIdElem = document.getElementById('roleId');
        const roleNameElem = document.getElementById('roleNameD');
        const editUsersLink = document.getElementById('editUsersLink');
        const editClaimsLink = document.getElementById('editClaimsLink');
        const usersCardBody = document.getElementById('usersCardBody');

        document.body.addEventListener("click", async (e) => {
            const button = e.target.closest(".open-modal");
            if (!button) return;

            const roleId = button.dataset.id;

            modalTitle.textContent = "Loading...";
            bootstrapModal.show();

            try {
                const res = await fetch(`https://localhost:7050/collate/admin/roles/${roleId}`);
                if (!res.ok) throw new Error("Failed to fetch role");

                const role = await res.json();

                // Update modal content
                const roleNameDisplay = role.roleName === 'sceneOfficer' ? 'SCENE Officer' : role.roleName;
                console.log(role.roleName)
                roleIdElem.textContent = role.id;
                roleNameElem.textContent = roleNameDisplay;

                editUsersLink.href = `/Administration/EditUsersInRole?roleId=${role.id}`;
                editClaimsLink.href = `/Administration/ManageRoleClaims?roleId=${role.id}`;

                // Users in role
                usersCardBody.innerHTML = '';
                const usersInRole = role.users || [];
                if (usersInRole.length === 0) {
                    usersCardBody.innerHTML = `<span class="badge bg-red-soft text-red">None at the moment</span>`;
                } else {
                    usersInRole.forEach(u => {
                        usersCardBody.insertAdjacentHTML('beforeend', `
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div class="d-flex align-items-center flex-shrink-0 me-3">
                                    <div class="avatar avatar-xl me-3 bg-gray-200">
                                        <img class="avatar-img img-fluid" src="/UserImages/${escapeHtml(u.imageUrl || 'default.png')}" alt="" />
                                    </div>
                                    <div class="d-flex flex-column fw-bold">
                                        <p class="text-dark line-height-normal mb-1">${escapeHtml(u.firstName)} ${escapeHtml(u.lastName)}</p>
                                        <div class="small text-muted line-height-normal">${escapeHtml(u.email)}</div>
                                    </div>
                                </div>
                            </div>
                        `);
                    });
                }

                feather.replace(); // render icons
                modalTitle.textContent = roleNameDisplay;
            } catch (err) {
                console.error(err);
                toastr.error("Failed to load role details or users");
                modalTitle.textContent = "Error";
            }
        });

        function escapeHtml(value) {
            const div = document.createElement('div');
            div.textContent = value ?? '';
            return div.innerHTML;
        }
    });


</script>