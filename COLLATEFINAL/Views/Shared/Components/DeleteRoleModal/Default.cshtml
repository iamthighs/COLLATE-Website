<div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteRoleModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteRoleForm" method="post">
                <div class="modal-body">
                    <div class="mb-3" id="deleteRoleModalBody"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-danger-soft text-danger" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary-soft text-primary">
                        Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modalElement = document.getElementById("deleteRoleModal");
        const modal = new bootstrap.Modal(modalElement);

        const form = document.getElementById("deleteRoleForm");
        const modalTitle = document.getElementById("deleteRoleModalTitle");
                const modalBody = document.getElementById("deleteRoleModalBody");

        document.body.addEventListener("click", (e) => {
            const button = e.target.closest(".open-delete-role-modal");
            if (!button) return;

            const roleId = button.dataset.id;
            const roleName = button.dataset.name;

            // Set modal data
            modalBody.textContent = `Are you sure you want to delete ${roleName}?`;
            modalTitle.textContent = `Delete Role: ${roleName}`;

            // Update form action dynamically
            form.action = `/Administration/DeleteRole/${roleId}`;

            modal.show();
        });
    });
</script>
