@model SubjectsPaginatedResult<SubjectModel>

@{
    ViewData["Title"] = "List";
    ViewData["ActivePage"] = ManageSidebar.CMSPrototype;

}
<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<style>
    div.scrollmenu {
        background-color: white;
        overflow: auto;
        white-space: nowrap;
    }

        div.scrollmenu a {
            display: inline-block;
            color: white;
            text-align: center;
            padding: 14px;
            text-decoration: none;
        }

            div.scrollmenu a:hover {
                background-color: #777;
            }
</style>
<partial name="_NewNavbar" />
<div id="layoutSidenav">
    <partial name="_NewSidenav" />
    <div id="layoutSidenav_content">
        <main>
            <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
                <div class="container-fluid px-4">
                    <div class="page-header-content">
                        <div class="row align-items-center justify-content-between pt-3">
                            <div class="col-auto mb-3">
                                <h1 class="page-header-title">
                                    <div class="page-header-icon"><i data-feather="bookmark"></i></div>
                                    Subjects
                                </h1>
                            </div>
                            <div class="col-12 col-xl-auto mb-3">
                                <a class="btn btn-sm btn-light text-primary" asp-action="ListLectures" asp-controller="Prototype">
                                    <i class="me-1" data-feather="book"></i>
                                    Lectures
                                </a>
                                <a class="btn btn-sm btn-light text-primary" asp-action="ListVideos" asp-controller="Prototype">
                                    <i class="me-1" data-feather="video"></i>
                                    Videos
                                </a>
                                <a class="btn btn-sm btn-light text-primary" asp-action="Create" asp-controller="Subjects">
                                    <i class="me-1" data-feather="plus"></i>
                                    Create New
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!-- Main page content-->
            <div class="container-xl px-4 mt-4">
                <partial name="_Notification" />

                <div class="card card-scrollable">
                    <div class="card-body" style="max-height:50rem">
                        <table id="datatablesSimple">

                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Date Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="subjectsTableBody">
                                <tr>
                                    <td colspan="4" class="text-center">Loading...</td>
                                </tr>
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </main>
        <partial name="_NewFooter" />
    </div>
</div>



@section Scripts {
    <script src="~/js/CustomScripts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
}

<script>

        document.addEventListener("DOMContentLoaded", () => {
        const tbody = document.getElementById('subjectsTableBody');
        if (!tbody) {
            console.error("subjectsTableBody element not found!");
            return;
        }

        const apiBase = 'https://localhost:7050/collate/subjects';

        async function loadSubjects() {
            try {
                const res = await fetch(`${apiBase}?pageNumber=1&pageSize=100`);
                if (!res.ok) throw new Error("Failed to fetch subjects");
                const data = await res.json();

                tbody.innerHTML = ''; // clear table first

                if (!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center">No subjects found</td></tr>';
                    return;
                }

                data.forEach(item => {
                    const tr = document.createElement('tr');

                    tr.innerHTML = `
                        <td><span class="badge bg-blue-soft text-blue">${item.code}</span></td>
                        <td>${item.subject}</td>
                        <td>${new Date(item.postedDate).toLocaleDateString(undefined, {
                            weekday: 'long', day: '2-digit', month: 'long', year: 'numeric'
                        })}</td>
                        <td>
                            <a class="btn btn-datatable btn-icon btn-transparent-dark me-2" href="/subjects/edit/${item.id}">
                                <i data-feather="edit"></i>
                            </a>
                            <a class="btn btn-datatable btn-icon btn-transparent-dark" href="#" data-bs-toggle="modal" data-bs-target="#deleteModal_${item.id}">
                                <i data-feather="trash-2"></i>
                            </a>
                        </td>
                    `;

                    // append row
                    tbody.appendChild(tr);

                    // append modal for delete confirmation
                    const modalWrapper = document.createElement('div');
                    modalWrapper.innerHTML = `
                        <div class="modal fade" id="deleteModal_${item.id}" tabindex="-1" role="dialog" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Delete a Subject</h5>
                                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete <span class="text-danger">${item.subject}</span>?
                                    </div>
                                    <div class="modal-footer">
                                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button>
                                        <button type="button" class="btn btn-primary" onclick="deleteSubject(${item.id})" data-bs-dismiss="modal">Delete</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    document.body.appendChild(modalWrapper.firstElementChild);
                });

                feather.replace(); // render icons
            } catch (err) {
                console.error(err);
                toastr.error("Failed to load subjects");
            }
        }

        async function deleteSubject(id) {
            try {
                const res = await fetch(`${apiBase}/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    toastr.success("Subject deleted successfully");
                    loadSubjects(); // reload table
                } else {
                    const errText = await res.text();
                    toastr.error(errText || "Failed to delete subject");
                }
            } catch (err) {
                console.error(err);
                toastr.error("Failed to delete subject");
            }
        }

        // attach globally
        window.deleteSubject = deleteSubject;

        // initial load
        loadSubjects();
    });

</script>