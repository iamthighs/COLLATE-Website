@model IEnumerable<IdentityRole>


@{
    ViewData["Title"] = "All Roles";
    ViewData["ActivePage"] = ManageSidebar.ListRoles;
}

<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<partial name="_NewNavbar" />
<div id="layoutSidenav">
<partial name="_NewSidenav"/>
<div id="layoutSidenav_content">
    <main>
        <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
            <partial name="_Notification" />
            <div class="container-fluid px-4">
                <div class="page-header-content">
                    <div class="row align-items-center justify-content-between pt-3">
                        <div class="col-auto mb-3">
                            <h1 class="page-header-title">
                                <div class="page-header-icon"><i data-feather="users"></i></div>
                                Roles List
                            </h1>
                        </div>
                        <div class="col-12 col-xl-auto mb-3">
                            <a class="btn btn-sm btn-light text-primary" asp-action="ListUsers">
                                <i class="me-1" data-feather="user"></i>
                                Manage Users
                            </a>
                                        
                            <button class="btn btn-sm btn-light text-primary" type="button" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                                <i class="me-1" data-feather="plus"></i>
                                Create New Role
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <!-- Main page content-->
        <div class="container-fluid px-4">
            <div class="card card-scrollable">
                <div class="card-body" style="max-height:50rem">
                    <table id="datatablesSimple">
                        <thead class="text-center">
                            <tr>
                                <th>Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var role in Model)
                            {
                                <tr>
                                    <td>
                                        @if (role.Name == "sceneOfficer")
                                        {
                                            <div>SCENE Officer</div>
                                        }
                                        else
                                        {
                                            <div>@role.Name</div>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-light text-primary open-modal" data-id="@role.Id">
                                            <i class="me-1" data-feather="user"></i>
                                            Manage Role
                                        </button>
                                        <button class="btn btn-datatable btn-icon btn-transparent-dark open-edit-role-modal" data-id="@role.Id" data-name="@role.Name">
                                            <i data-feather="edit"></i>
                                        </button>
                                            <button class="btn btn-datatable btn-icon btn-transparent-dark open-delete-modal" data-id="@role.Id" data-name="@role.Name" data-title="Delete Role" data-action="/Administration/DeleteRole">
                                            <i data-feather="trash-2"></i>
                                        </button>

                                    </td>
                                </tr>

                            }

                                
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @await Component.InvokeAsync("CreateRoleModal")
        @await Component.InvokeAsync("EditRoleModal")
        @await Component.InvokeAsync("ManageRoleModal")
        @await Component.InvokeAsync("DeleteModal")
    </main>
    <partial name="_NewFooter"/>
</div>
</div>

@section Scripts {
    <script src="~/js/CustomScripts.js"></script>
}