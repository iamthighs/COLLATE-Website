# User/IDE files
COLLATEWEBAPI/*.user
COLLATEWEBAPI/*.suo
COLLATEWEBAPI/.vs/
COLLATE.Helpers/*.user
COLLATE.Helpers/.vs/
_ReSharper*/
*.DotSettings.user
*.dotCover
TestResults/
*.trx
*.coverage
*.coveragexml

# Ignore local secrets
