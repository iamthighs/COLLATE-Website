<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRoleModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editRoleForm" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="small text-muted mb-1" for="editRoleName">Role Name</label>
                        <input id="editRoleName"
                               name="roleName"
                               type="text"
                               class="form-control"
                               required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-danger-soft text-danger" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary-soft text-primary">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modalElement = document.getElementById("editRoleModal");
        const modal = new bootstrap.Modal(modalElement);

        const form = document.getElementById("editRoleForm");
        const roleNameInput = document.getElementById("editRoleName");
        const modalTitle = document.getElementById("editRoleModalTitle");

        document.body.addEventListener("click", (e) => {
            const button = e.target.closest(".open-edit-role-modal");
            if (!button) return;

            const roleId = button.dataset.id;
            const roleName = button.dataset.name;

            // Set modal data
            roleNameInput.value = roleName;
            modalTitle.textContent = `Edit Role: ${roleName}`;

            // Update form action dynamically
            form.action = `/Administration/EditRole/${roleId}`;

            modal.show();
        });
    });
</script>
